# MIYA — muhit o'zgaruvchilari (kalitlarni panel «Sozlamalar» orqali ham kiritish mumkin — bazada shifrlangan saqlanadi)
MIYA_HOST=127.0.0.1
MIYA_PORT=8090
MIYA_BAZA=malumot/miya.db
# Faqat ishonchli proksi (Caddy) ortida: X-Real-IP va X-Forwarded-Proto qabul qilinadi
MIYA_PROXY=0
# Sun'iy intellekt (LLM API) kaliti — bo'lmasa dastur AI'siz, tugmalar bilan ishlaydi
MIYA_ANTHROPIC_KALIT=
# Ovozni matnga o'girish (Google Speech-to-Text) kaliti
MIYA_GOOGLE_KALIT=
# Telegram bot tokeni (@BotFather)
MIYA_BOT_TOKEN=
